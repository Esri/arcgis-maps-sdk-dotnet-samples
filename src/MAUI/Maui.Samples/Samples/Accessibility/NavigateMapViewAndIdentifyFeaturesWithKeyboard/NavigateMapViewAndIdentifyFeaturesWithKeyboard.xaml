<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ArcGIS.Samples.NavigateMapViewAndIdentifyFeaturesWithKeyboard.NavigateMapViewAndIdentifyFeaturesWithKeyboard"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:esriUI="clr-namespace:Esri.ArcGISRuntime.Maui;assembly=Esri.ArcGISRuntime.Maui">
    <Grid Style="{DynamicResource EsriSampleContainer}">
        <esriUI:MapView x:Name="MyMapView"
                        Style="{DynamicResource EsriSampleGeoView}" />
        <Grid x:Name="SelectionRectangle"
              WidthRequest="200"
              HeightRequest="200"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              InputTransparent="True">
            <BoxView HeightRequest="2"
                     Color="#1F2328"
                     VerticalOptions="Start" />
            <BoxView HeightRequest="2"
                     Color="#1F2328"
                     VerticalOptions="End" />
            <BoxView WidthRequest="2"
                     Color="#1F2328"
                     HorizontalOptions="Start" />
            <BoxView WidthRequest="2"
                     Color="#1F2328"
                     HorizontalOptions="End" />
        </Grid>
        <Border Style="{DynamicResource EsriSampleControlPanel}">
            <VerticalStackLayout Spacing="0">
                <Label Text="Pan and zoom to bring restaurants into the area of interest. Press 1-9 for details, Esc to dismiss."
                       LineBreakMode="WordWrap" />
                <Label x:Name="OverflowMessage"
                       Margin="0,8,0,0"
                       FontAttributes="Italic"
                       TextColor="#BE185D"
                       LineBreakMode="WordWrap"
                       IsVisible="False"
                       Text="Too many features in the area. Zoom in to see fewer." />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>