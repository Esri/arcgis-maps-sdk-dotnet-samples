<?xml version="1.0" encoding="utf-8" ?>

<ContentPage x:Class="ArcGIS.Samples.WmsServiceCatalog.WmsServiceCatalog"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ArcGIS.Samples.WmsServiceCatalog"
             xmlns:esriUI="clr-namespace:Esri.ArcGISRuntime.Maui;assembly=Esri.ArcGISRuntime.Maui">
    <Grid Style="{DynamicResource EsriSampleContainer}">
        <esriUI:MapView x:Name="MyMapView" Style="{DynamicResource EsriSampleGeoView}" />
        <Border Style="{DynamicResource EsriSampleControlPanel}" WidthRequest="{OnPlatform WinUI=425}">
            <VerticalStackLayout>
                <Label FontAttributes="Bold" Text="Select a WMS layer from the list for display:" />
                <CollectionView x:Name="MyDisplayList"
                                HeightRequest="{OnPlatform iOS=200,
                                                           MacCatalyst=200}"
                                SelectionChanged="MyDisplayList_SelectionChanged"
                                SelectionMode="Single">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:LayerDisplayVM">
                            <Label Padding="12,8" Text="{Binding Name}" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>