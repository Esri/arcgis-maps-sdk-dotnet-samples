<UserControl x:Class="ArcGIS.WPF.Samples.UpdateBasemapForContrastAccessibility.UpdateBasemapForContrastAccessibility"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013">
    <Grid>
        <esri:MapView x:Name="MyMapView" />
        <Border Width="260"
                Style="{StaticResource BorderStyle}"
                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                TextElement.Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
            <StackPanel>
                <CheckBox x:Name="ReferenceLayersCheckBox"
                          Content="Show reference layers"
                          IsChecked="True"
                          Checked="ReferenceLayersCheckBox_CheckedChanged"
                          Unchecked="ReferenceLayersCheckBox_CheckedChanged" />
                <Separator Margin="0,8" />

                <TextBlock Margin="0,0,0,5" FontWeight="Bold" Text="Contrast mode" />
                <RadioButton x:Name="AutomaticModeRadioButton"
                             Content="Automatic (follow Windows)"
                             GroupName="ContrastMode"
                             IsChecked="True"
                             Checked="ContrastModeRadioButton_Checked" />
                <RadioButton x:Name="ManualModeRadioButton"
                             Content="Manual"
                             GroupName="ContrastMode"
                             Checked="ContrastModeRadioButton_Checked" />

                <StackPanel x:Name="OpenSettingsPanel" Margin="0,6,0,0">
                    <Button Margin="0,0,0,4"
                            Click="OpenThemeSettingsButton_Click"
                            Content="Open theme settings" />
                    <Button Click="OpenContrastSettingsButton_Click"
                            Content="Open contrast settings" />
                </StackPanel>

                <StackPanel x:Name="ManualAppearancePanel" Visibility="Collapsed">
                    <Separator Margin="0,8" />
                    <TextBlock Margin="0,0,0,5" FontWeight="Bold" Text="Manual contrast" />
                    <RadioButton x:Name="LightRadioButton"
                                 Content="Light"
                                 GroupName="ContrastAppearance"
                                 IsChecked="True"
                                 Checked="ManualAppearanceRadioButton_Checked" />
                    <RadioButton x:Name="DarkRadioButton"
                                 Content="Dark"
                                 GroupName="ContrastAppearance"
                                 Checked="ManualAppearanceRadioButton_Checked" />
                    <RadioButton x:Name="HighContrastLightRadioButton"
                                 Content="High contrast light"
                                 GroupName="ContrastAppearance"
                                 Checked="ManualAppearanceRadioButton_Checked" />
                    <RadioButton x:Name="HighContrastDarkRadioButton"
                                 Content="High contrast dark"
                                 GroupName="ContrastAppearance"
                                 Checked="ManualAppearanceRadioButton_Checked" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
