<UserControl x:Class="ArcGIS.WPF.Samples.AddFeaturesWithSharedTemplate.AddFeaturesWithSharedTemplate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013"
             xmlns:converters="clr-namespace:ArcGIS.WPF.Viewer.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <esri:MapView x:Name="MyMapView" />
        <Border MaxWidth="270"
                Margin="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Style="{StaticResource BorderStyle}">
            <StackPanel>
                <TextBlock x:Name="StatusTextBlock"
                           Text="Loading shared templates..."
                           TextWrapping="Wrap" />
                <ItemsControl x:Name="TemplatePicker"
                              Visibility="Collapsed"
                              Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Click="OnSharedTemplateClicked"
                                    Tag="{Binding}"
                                    ToolTip="{Binding Template.Description}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="36"
                                           Height="36"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Source="{Binding ImageSource}" />
                                    <StackPanel Grid.Column="1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding Template.Name}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Template.Type, StringFormat=({0})}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Margin="0,8,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding GeometryEditor.IsStarted, ElementName=MyMapView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Margin="0,0,6,0" Click="OnGeometryEditorCompleted" Content="Complete" />
                    <Button Click="OnGeometryEditorCanceled" Content="Cancel" />
                </StackPanel>
                <StackPanel x:Name="PendingEditsPanel"
                            Margin="0,8,0,0"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <Button Margin="0,0,6,0" Click="OnEditsSaved" Content="Save" />
                    <Button Click="OnEditsUndone" Content="Undo" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>