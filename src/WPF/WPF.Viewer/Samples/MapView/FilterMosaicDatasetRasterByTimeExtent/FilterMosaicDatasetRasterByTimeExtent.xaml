<UserControl x:Class="ArcGIS.WPF.Samples.FilterMosaicDatasetRasterByTimeExtent.FilterMosaicDatasetRasterByTimeExtent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013">
    <Grid>
        <esri:MapView x:Name="MyMapView" />
        <Border Style="{StaticResource BorderStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="FirstButton"
                            Width="40"
                            Margin="0,0,4,0"
                            AutomationProperties.Name="First timestamp"
                            Click="FirstButton_Click"
                            Content="|&lt;"
                            IsEnabled="False" />
                    <Button x:Name="PreviousButton"
                            Grid.Column="1"
                            Width="40"
                            AutomationProperties.Name="Previous timestamp"
                            Click="PreviousButton_Click"
                            Content="&lt;"
                            IsEnabled="False" />
                    <TextBlock x:Name="TimestampText"
                               Grid.Column="2"
                               Margin="4,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="Loading..." />
                    <Button x:Name="NextButton"
                            Grid.Column="3"
                            Width="40"
                            AutomationProperties.Name="Next timestamp"
                            Click="NextButton_Click"
                            Content="&gt;"
                            IsEnabled="False" />
                    <Button x:Name="LastButton"
                            Grid.Column="4"
                            Width="40"
                            Margin="4,0,0,0"
                            AutomationProperties.Name="Last timestamp"
                            Click="LastButton_Click"
                            Content="&gt;|"
                            IsEnabled="False" />
                </Grid>
                <Grid Margin="0,12,0,0">
                    <TextBlock Text="Opacity" />
                    <TextBlock x:Name="OpacityValue"
                               HorizontalAlignment="Right"
                               Text="100%" />
                </Grid>
                <Slider x:Name="OpacitySlider"
                        Margin="0,5,0,0"
                        AutomationProperties.Name="Raster opacity"
                        IsEnabled="False"
                        IsSnapToTickEnabled="True"
                        Maximum="1"
                        Minimum="0"
                        SmallChange="0.01"
                        TickFrequency="0.01"
                        Value="1"
                        ValueChanged="OpacitySlider_ValueChanged" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
