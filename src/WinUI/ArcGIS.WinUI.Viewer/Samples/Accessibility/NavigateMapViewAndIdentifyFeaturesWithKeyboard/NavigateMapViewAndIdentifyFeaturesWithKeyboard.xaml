<UserControl x:Class="ArcGIS.WinUI.Samples.NavigateMapViewAndIdentifyFeaturesWithKeyboard.NavigateMapViewAndIdentifyFeaturesWithKeyboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:esriUI="using:Esri.ArcGISRuntime.UI.Controls">
    <Grid>
        <esriUI:MapView x:Name="MyMapView" />
        <Rectangle x:Name="SelectionRectangle"
                   Width="200"
                   Height="200"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Stroke="#FF1F2328"
                   StrokeThickness="2" />
        <Border Style="{StaticResource BorderStyle}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap"
                           Text="Pan and zoom to bring restaurants into the area of interest. Press 1-9 for details, Esc to dismiss." />
                <TextBlock x:Name="OverflowMessage"
                           Margin="0,8,0,0"
                           FontStyle="Italic"
                           Foreground="#BE185D"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Text="Too many features in the area. Zoom in to see fewer." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>