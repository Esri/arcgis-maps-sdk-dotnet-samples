<UserControl
    x:Class="ArcGIS.WinUI.Samples.AnalyzeTerrainSuitabilityFromSlopeAndAspect.AnalyzeTerrainSuitabilityFromSlopeAndAspect"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:esriUI="using:Esri.ArcGISRuntime.UI.Controls">
    <Grid>
        <esriUI:MapView x:Name="MyMapView" />
        <Border Style="{StaticResource BorderStyle}">
            <StackPanel>
                <TextBlock
                    FontWeight="SemiBold"
                    Text="Sheltered vs. exposed terrain suitability"
                    TextWrapping="Wrap" />
                <RadioButton
                    x:Name="LowlandSouthFacingSlopesRadioButton"
                    Margin="0,10,0,0"
                    Checked="OnScenarioSelectionChanged"
                    IsChecked="True">
                    <TextBlock Text="Gentle, lowland south-facing slopes" TextWrapping="Wrap" />
                </RadioButton>
                <RadioButton
                    x:Name="UplandWestToNorthFacingSlopesRadioButton"
                    Margin="0,5,0,0"
                    Checked="OnScenarioSelectionChanged">
                    <TextBlock Text="Steep, upland west- through north-facing slopes" TextWrapping="Wrap" />
                </RadioButton>
                <ProgressBar
                    x:Name="AnalysisProgressBar"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Stretch"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <TextBlock
            Margin="0,0,10,30"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            FontSize="11"
            FontStyle="Italic"
            Foreground="DimGray"
            Text="Raster data Copyright Scottish Government and SEPA (2014)"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
