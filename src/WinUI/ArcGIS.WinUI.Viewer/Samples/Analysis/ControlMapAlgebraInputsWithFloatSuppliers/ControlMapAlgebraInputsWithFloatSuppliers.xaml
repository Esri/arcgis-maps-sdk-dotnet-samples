<UserControl
    x:Class="ArcGIS.WinUI.Samples.ControlMapAlgebraInputsWithFloatSuppliers.ControlMapAlgebraInputsWithFloatSuppliers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:esriUI="using:Esri.ArcGISRuntime.UI.Controls">
    <Grid>
        <esriUI:MapView x:Name="MyMapView" />
        <Border Style="{StaticResource BorderStyle}">
            <StackPanel>
                <TextBlock x:Name="SlopeRangeText"
                           Margin="0,0,0,8"
                           Text="Slope range: 0 to 10 degrees" />
                <toolkit:RangeSelector x:Name="SlopeRangeSlider"
                                       AutomationProperties.Name="Slope range in degrees"
                                       IsEnabled="False"
                                       Minimum="0"
                                       Maximum="85"
                                       RangeStart="0"
                                       RangeEnd="10"
                                       StepFrequency="1"
                                       ValueChanged="OnSlopeRangeChanged" />
                <TextBlock Margin="0,8,0,0"
                           Text="Slope colors on the map: dark purple (flat, 0&#176;) to yellow (steep, 85&#176;)."
                           TextWrapping="Wrap" />
                <TextBlock x:Name="AnalysisStatusText"
                           Margin="0,8,0,0"
                           Text="Loading elevation..." />
                <ProgressBar x:Name="AnalysisProgressBar"
                             Margin="0,4,0,0"
                             IsIndeterminate="True"
                             Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>